# ===== 阿里云百炼 DashScope（OpenAI 兼容接口）=====
# 在百炼控制台申请 API Key 后填入
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# qwen-turbo 最便宜有免费额度；qwen-plus 均衡；qwen-max 更强；qwen-long 支持超长上下文
LLM_MODEL=qwen-turbo

# ===== MongoDB（对应 docker-compose.yml）=====
MONGO_URI=mongodb://admin:admin123@localhost:27017
MONGO_DB=procurement_agent

# ===== ERP 后端地址（MCP Server 对接；本地默认指向 mock_erp，生产替换为真实 ERP）=====
ERP_BASE_URL=http://localhost:8080

# ===== MCP Server 自身监听地址 =====
MCP_HOST=0.0.0.0
MCP_PORT=8001

# ===== 沙箱镜像 =====
SANDBOX_IMAGE=python:3.11-slim

# ===== 网页搜索（Tavily，采购研究员抓报价/信息用）=====
# 在 https://app.tavily.com 免费注册获取
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
